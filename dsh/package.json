{
  "name": "@kolezka/design-studio-dsh",
  "version": "0.4.1",
  "private": true,
  "license": "SEE LICENSE IN ../LICENSE",
  "description": "DeepSeek Harness adapter for the design-studio Claude Code plugin",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "canvas.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "bun.lock"
  ],
  "dependencies": {
    "claude-plugin-dsh": "0.2.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
